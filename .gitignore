# Exercise media (~140 MB) — fetched locally via `npm run media:fetch`, never committed
frontend/public/media/

# Local runtime data (never committed)
data/

# Local config (Vite reads frontend/.env* — local variants stay untracked,
# the documented example stays tracked; see frontend/.env.example)
.env
.env.local
.env.*.local
!**/.env.example

# Build output / deps
frontend/dist/
frontend/.tmp/
.tmp/
.scratch/
node_modules/
*.log
.DS_Store
.freebuff/
.impeccable/
frontend/.impeccable/
.netlify/
.scratchpad/
