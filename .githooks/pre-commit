#!/bin/sh
# Every commit must leave the suite green. cad7a52 landed with two dangling
# references (an import of a file that was never committed, and an unexported
# helper) because nothing gated the commit. This hook is that gate.
# Skip once, knowingly: git commit --no-verify

cd frontend || exit 1
# oxlint and tsc through their ratchets (lint-baseline.json, tsc-baseline.json).
# ESLint stays in CI (`npm run lint`): the compiler rules take about 19 s.
node scripts/check-lint-baseline.mjs && npm run typecheck && npm test
