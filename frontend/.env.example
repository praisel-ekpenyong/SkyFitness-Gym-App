# Sky environment example — copy to .env to override. All values are optional.
# Every variable is read through frontend/src/lib/env.js (validateEnv) — see
# that file for defaults and validation. Builds stay host-agnostic: no value
# here is required for any host.

# '1' builds the Capacitor app-store shell (native file mirror, share sheet,
# reminders). Anything else (including unset) builds the web PWA.
VITE_MOBILE=

# Self-hosted media overrides. Defaults serve `npm run media:fetch` output from
# media/images/ and media/videos/, with pinned-CDN fallback per asset.
VITE_IMG_BASE=media/images/
VITE_GIF_BASE=media/videos/

# Optional web analytics (Umami). Injected into index.html only when BOTH are
# set at build time; a plain `npm run build` stays telemetry-free.
# VITE_UMAMI_SRC=https://stats.example/script.js
# VITE_UMAMI_ID=00000000-0000-4000-8000-000000000000
VITE_UMAMI_SRC=
VITE_UMAMI_ID=

# BASE_URL is Vite-provided (from vite.config.js `base`, default './'), not set
# here — listed so every environment-gated behavior has one documented home.
# The seam reads and normalizes it for subpath service-worker scope.
