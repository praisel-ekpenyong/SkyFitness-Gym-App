{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "react",
    "oxc",
    "jsx-a11y",
    "unicorn"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "__APP_VERSION__": "readonly"
  },
  "ignorePatterns": [
    "dist/**",
    "android/**",
    "ios/**",
    "public/**",
    "coverage/**",
    "**/*.test.*",
    "**/*.spec.*",
    "src/test/**",
    "scripts/fixtures/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/no-array-index-key": "error",
    "eslint/no-throw-literal": "error",
    "eslint/prefer-promise-reject-errors": "error",
    "eslint/complexity": ["error", { "max": 15, "variant": "modified" }],
    "eslint/no-unused-vars": [
      "error",
      {
        "args": "none",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "eslint/no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/capitalized-calls": "off",
    "react/error-boundaries": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/globals": "off",
    "react/hooks": "off",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react/invariant": "off",
    "react/memo-dependencies": "off",
    "react/no-deriving-state-in-effects": "off",
    "react/preserve-manual-memoization": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/rule-suppression": "off",
    "react/set-state-in-effect": "off",
    "react/set-state-in-render": "off",
    "react/static-components": "off",
    "react/syntax": "off",
    "react/todo": "off",
    "react/unsupported-syntax": "off",
    "react/use-memo": "off",
    "react/void-use-memo": "off",
    "jsx-a11y/alt-text": "off",
    "jsx-a11y/anchor-ambiguous-text": "off",
    "jsx-a11y/anchor-has-content": "off",
    "jsx-a11y/anchor-is-valid": "off",
    "jsx-a11y/aria-activedescendant-has-tabindex": "off",
    "jsx-a11y/aria-props": "off",
    "jsx-a11y/aria-proptypes": "off",
    "jsx-a11y/aria-role": "off",
    "jsx-a11y/aria-unsupported-elements": "off",
    "jsx-a11y/autocomplete-valid": "off",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/heading-has-content": "off",
    "jsx-a11y/html-has-lang": "off",
    "jsx-a11y/iframe-has-title": "off",
    "jsx-a11y/img-redundant-alt": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/lang": "off",
    "jsx-a11y/media-has-caption": "off",
    "jsx-a11y/mouse-events-have-key-events": "off",
    "jsx-a11y/no-access-key": "off",
    "jsx-a11y/no-aria-hidden-on-focusable": "off",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "off",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",
    "jsx-a11y/no-redundant-roles": "off",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/role-has-required-aria-props": "off",
    "jsx-a11y/role-supports-aria-props": "off",
    "jsx-a11y/scope": "off",
    "jsx-a11y/tabindex-no-positive": "off",
    "eslint/no-restricted-globals": [
      "error",
      {
        "checkGlobalObject": true,
        "globals": [
          { "name": "__dirname", "message": "__dirname is CommonJS. Sky is ESM: use import.meta.dirname, import.meta.filename or import.meta.url." },
          { "name": "__filename", "message": "__filename is CommonJS. Sky is ESM: use import.meta.dirname, import.meta.filename or import.meta.url." },
          { "name": "require", "message": "require is CommonJS. Sky is ESM: use import.meta.dirname, import.meta.filename or import.meta.url." },
          { "name": "localStorage", "message": "localStorage belongs to platform/storage.js." },
          { "name": "indexedDB", "message": "indexedDB belongs to platform/storage.js." },
          { "name": "AudioContext", "message": "AudioContext belongs to platform/sound.js." },
          { "name": "webkitAudioContext", "message": "webkitAudioContext belongs to platform/sound.js." },
          { "name": "Notification", "message": "Notification belongs to platform/. useUI.js and main.jsx are allowlisted until that code moves." },
          { "name": "console", "message": "console belongs to components/ErrorBoundary.jsx and components/Modals.jsx." },
          { "name": "fetch", "message": "fetch belongs to platform/media-warm.js." }
        ]
      }
    ],
    "eslint/no-restricted-properties": [
      "error",
      { "object": "navigator", "property": "vibrate", "message": "navigator.vibrate belongs to platform/sound.js." },
      { "object": "navigator", "property": "wakeLock", "message": "navigator.wakeLock belongs to platform/wakelock.js." },
      { "object": "navigator", "property": "serviceWorker", "message": "navigator.serviceWorker belongs to platform/. useUI.js and main.jsx are allowlisted until that code moves." },
      { "object": "Math", "property": "random", "message": "Math.random belongs to uid() in lib/format.js." }
    ],
    "unicorn/no-array-sort": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-await-in-promise-methods": "off",
    "unicorn/no-empty-file": "off",
    "unicorn/no-invalid-fetch-options": "off",
    "unicorn/no-invalid-remove-event-listener": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-single-promise-in-promise-methods": "off",
    "unicorn/no-thenable": "off",
    "unicorn/no-unnecessary-await": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-useless-length-check": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/prefer-set-size": "off",
    "unicorn/prefer-string-starts-ends-with": "off"
  },
  "overrides": [
    {
      // storage.js owns localStorage and indexedDB. Notification and serviceWorker stay allowed because platform/ owns them. Every other name stays banned.
      "files": ["src/platform/storage.js"],
      "rules": {
        "eslint/no-restricted-globals": [
          "error",
          {
            "checkGlobalObject": true,
            "globals": [
              { "name": "__dirname", "message": "__dirname is CommonJS. Sky is ESM: use import.meta.dirname, import.meta.filename or import.meta.url." },
              { "name": "__filename", "message": "__filename is CommonJS. Sky is ESM: use import.meta.dirname, import.meta.filename or import.meta.url." },
              { "name": "require", "message": "require is CommonJS. Sky is ESM: use import.meta.dirname, import.meta.filename or import.meta.url." },
              { "name": "AudioContext", "message": "AudioContext belongs to platform/sound.js." },
